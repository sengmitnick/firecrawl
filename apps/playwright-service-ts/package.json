{
  "name": "playwright-scraper-api",
  "version": "1.0.0",
  "description": "scraper api with playwright",
  "main": "api.ts",
  "scripts": {
    "start": "node dist/api.js",
    "build": "tsc",
    "dev": "ts-node api.ts",
    "pm2:start": "pm2 start npm --name playwright-service-ts -- start",
    "pm2:restart": "pm2 restart playwright-service-ts || pm2 start npm --name playwright-service-ts -- start",
    "pm2:stop": "pm2 stop playwright-service-ts || true",
    "pm2:delete": "pm2 delete playwright-service-ts || true",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs playwright-service-ts --lines 200",
    "pm2:enable": "pm2 startup && pm2 save",
    "pm2:cluster": "pm2 start npm --name playwright-service-ts -i max -- start",
    "pm2:memwatch": "pm2 restart playwright-service-ts --max-memory-restart 500M"
  },
  "keywords": [],
  "author": "Jeff Pereira",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "playwright": "^1.45.0",
    "user-agents": "^1.1.410"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/user-agents": "^1.0.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
